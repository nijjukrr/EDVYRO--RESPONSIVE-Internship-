# Server Configuration
PORT=5000
NODE_ENV=development

# Local SQLite Database Configuration (used when DATABASE_URL is unset in development/test)
DATABASE_PATH=./database/internships.db

# Production PostgreSQL Configuration (Required when NODE_ENV=production; set in Render Dashboard)
# Use your Neon pooled connection string — never commit real credentials.
# DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require&channel_binding=require
PG_POOL_MAX=5

# Production CORS Allowlist (comma-separated additional origins alongside https://nijjukrr.github.io)
CORS_ORIGINS=https://nijjukrr.github.io

# Security & Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
